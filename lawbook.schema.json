{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/drew-simmons/lawbook/main/lawbook.schema.json",
  "title": "lawbook.yaml",
  "description": "The rules lawbook checks a directory against.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "extends": {
      "default": [],
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "ignore": {
      "default": [
        "**/node_modules/**",
        "**/.git/**"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "gitignore": {
      "default": true,
      "type": "boolean"
    },
    "llm": {
      "default": {},
      "type": "object",
      "properties": {
        "provider": {
          "default": "bifrost",
          "type": "string",
          "enum": [
            "bifrost",
            "openai",
            "claude-code",
            "codex"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string",
          "format": "uri"
        },
        "concurrency": {
          "default": 4,
          "type": "integer",
          "minimum": 1
        },
        "maxBytes": {
          "default": 131072,
          "type": "integer",
          "minimum": 1
        },
        "cache": {
          "default": true,
          "type": "boolean"
        },
        "maxRequests": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "level": {
                "default": "error",
                "type": "string",
                "enum": [
                  "error",
                  "warn"
                ]
              },
              "files": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exclude": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "forbid": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "files",
              "forbid"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "level": {
                "default": "error",
                "type": "string",
                "enum": [
                  "error",
                  "warn"
                ]
              },
              "files": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exclude": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "require": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "files",
              "require"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "level": {
                "default": "error",
                "type": "string",
                "enum": [
                  "error",
                  "warn"
                ]
              },
              "exists": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            },
            "required": [
              "id",
              "exists"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "level": {
                "default": "error",
                "type": "string",
                "enum": [
                  "error",
                  "warn"
                ]
              },
              "absent": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              }
            },
            "required": [
              "id",
              "absent"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "level": {
                "default": "error",
                "type": "string",
                "enum": [
                  "error",
                  "warn"
                ]
              },
              "files": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "exclude": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "standard": {
                "type": "string",
                "minLength": 1
              },
              "threshold": {
                "default": 0.5,
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "scope": {
                "default": "file",
                "type": "string",
                "enum": [
                  "file",
                  "set"
                ]
              },
              "llm": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "bifrost",
                      "openai",
                      "claude-code",
                      "codex"
                    ]
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "baseUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "additionalProperties": false
              },
              "context": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "fixtures": {
                "type": "object",
                "properties": {
                  "pass": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "fail": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "files",
              "standard"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "version",
    "rules"
  ],
  "additionalProperties": false
}
